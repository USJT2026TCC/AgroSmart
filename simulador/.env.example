# Chaves privadas das estacoes simuladas. Cada fonte cadastrada no backend tem a
# sua, e o endereco publico correspondente e o que a seguradora cadastra.
#
# NUNCA comite este arquivo preenchido (RNF14). Em campo, cada estacao guarda a
# propria chave no equipamento.
#
# Para gerar uma chave nova:
#   python -c "from eth_account import Account; c=Account.create(); print(c.key.hex(), c.address)"
#
# A preparacao historica (npm run dados:preparar) nao usa chaves de estacao.
# Estas opcoes atendem somente ao envio HTTP manual de lotes assinados.

CHAVE_ESTACAO_INMET_A770=
CHAVE_ESTACAO_INMET_A747=

API_URL=http://localhost:3001/api
