{
  "name": "agrosmart-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API do AgroSmart: autenticacao, cadastro georreferenciado, ingestao assinada de leituras, indexacao dos eventos da cadeia e integracao com o oraculo.",
  "main": "src/index.js",
  "scripts": {
    "iniciar": "node src/index.js",
    "dev": "node --watch src/index.js",
    "testar": "node --import ../testes/backend/unitarios/preparar.js --test --test-concurrency=1 \"../testes/backend/unitarios/*.test.js\"",
    "migrar": "node src/banco/migrar.js",
    "formatar": "prettier --write \"src/**/*.js\"",
    "testar:integracao": "node --test --test-concurrency=1 \"../testes/backend/integracao/*.test.js\"",
    "cobertura": "c8 --reports-dir ../testes/gerados/backend/cobertura --all --src src --include \"src/**\" --reporter text-summary npm run testar"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-postgis": "^0.2.8",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.2",
    "ethers": "^6.17.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "nodemailer": "^10.0.16",
    "otplib": "^13.5.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "prettier": "^3.9.8",
    "supertest": "^7.2.2"
  }
}
