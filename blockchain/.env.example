# Sepolia: copie para .env e preencha; nunca envie o .env ao Git.
RPC_SEPOLIA=
# Apenas implantação, usando ETH de teste. API e interface não recebem esta chave.
CHAVE_PRIVADA_SEGURADORA=
# Serviço de oráculo; deve ser distinto da seguradora e do produtor.
CHAVE_PRIVADA_ORACULO=
# Opcional: endereço público. Se vazio, deriva da chave do oráculo.
ENDERECO_ORACULO=
# Verificação do código-fonte no explorador.
ETHERSCAN_API_KEY=
# Opcional, preço em gwei; em branco usa a estimativa do provedor.
PRECO_GAS_GWEI=
