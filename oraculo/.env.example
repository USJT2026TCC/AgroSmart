# Uso normal: npm start na raiz fornece RPC, chave e autenticacao de servico.
# Este exemplo e para execucao manual. Nunca versione .env nem chaves privadas.
REDE=sepolia
RPC_URL=
CHAVE_PRIVADA_ORACULO=
API_URL=http://localhost:3001/api
CHAVE_DE_SERVICO=

# A mesma pasta deve ser usada para retomar a fila da instancia.
DIR_DADOS=dados-sepolia
MAX_TENTATIVAS=5
ESPERA_BASE_MS=2000
CONFIRMACOES=1
TIMEOUT_MS=10000
INTERVALO_SERVICO_MS=60000

# Opcional para ouvir eventos de uma apolice especifica.
ENDERECO_APOLICE=
