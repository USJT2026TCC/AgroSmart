{
  "name": "agrosmart",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node scripts/iniciar.mjs iniciar",
    "status": "node scripts/iniciar.mjs status",
    "test": "node testes/executar.mjs",
    "stop": "node scripts/iniciar.mjs parar",
    "formatar": "prettier --write \"api/src/**/*.js\" \"interface/src/**/*.{js,jsx,css}\" \"oraculo/src/**/*.js\" \"scripts/*.mjs\" \"configuracao/*.js\"",
    "dados:preparar": "node scripts/preparar-dados.mjs",
    "dados:empacotar": "node scripts/empacotar-dados.mjs",
    "testar:docker": "node --test testes/infraestrutura/docker.integracao.test.mjs"
  },
  "workspaces": [
    "blockchain",
    "api",
    "oraculo",
    "interface"
  ]
}
