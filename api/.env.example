# Opções da API lidas pelo iniciador Docker; copie para .env apenas se precisar.
# Banco, rede, RPC e portas são configurados pelo iniciador da raiz.
# O uso tem um único PostgreSQL no Docker; não configure outro DATABASE_URL.

# Segredos opcionais: em branco, gerados e persistidos em .execucao/segredos.json.
# Ao reutilizar um banco com TOTP, informe o SEGREDO_DE_CIFRA original.
CHAVE_DE_SERVICO=
SEGREDO_DE_CIFRA=

# E-mail é opcional na demonstração. Sem SMTP, mensagens ficam na caixa local.
EMAIL=desligado
SMTP_URL=
