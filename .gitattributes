# Quebras de linha normalizadas para LF no repositorio, qualquer que seja o
# sistema de quem commita. Sem isso, cada integrante no Windows produz diffs
# com a linha inteira alterada so por causa do CRLF.
* text=auto eol=lf

*.docx binary
*.png binary
*.jpg binary
*.jpeg binary

# CSVs publicos do INMET: preservar exatamente os bytes cobertos pelo SHA-256.
backend/recursos/inmet/A770/*.csv -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
