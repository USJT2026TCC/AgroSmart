# Dependencias
node_modules/

# Segredos â€” nunca versionar (RNF14, RNF15)
.env
.env.*
!.env.example
*.key
*.pem

# Artefatos de build do Hardhat
blockchain/artifacts/
blockchain/cache/
blockchain/typechain-types/
blockchain/coverage/
blockchain/coverage.json
# Medicoes de cobertura (RNF03): geradas a cada execucao, nao versionadas.
coverage/
.coverage
htmlcov/
blockchain/gas-report.txt

# Saidas de execucao do oraculo: estado local, nao codigo-fonte
oraculo/dados/fila.json
oraculo/dados/publicacoes.jsonl
oraculo/dados/*.log
oraculo/dados-sepolia/

# Enderecos de rede local mudam a cada `npx hardhat node`. Os de rede de teste
# publica (sepolia*.json) sao versionados de proposito: a banca precisa poder
# conferir no explorador de blocos qual contrato foi implantado.
blockchain/implantacoes/localhost*.json

# Sistema operacional / editores
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# Build do aplicativo
interface/dist/

# Gerado por `npm run enderecos` a partir de blockchain/implantacoes/.
# Nao e versionado porque carrega enderecos da maquina de quem implantou; o
# script roda automaticamente antes de `npm run dev` e `npm run build`.
interface/src/cadeia/implantacoes.json

# Estado local da API: caixa de saída de e-mails
api/dados/

# Arquivos temporarios de bloqueio do Word
~$*.docx

# Estado do iniciador integrado
.execucao/

# Saidas de todas as verificacoes
testes/gerados/

# Caches Python, inclusive das suites centralizadas
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
